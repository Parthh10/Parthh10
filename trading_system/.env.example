# Copy this file to .env and fill in your values.
# The system works WITHOUT any keys (Yahoo Finance fallback).
# Adding a Tradier key upgrades you to real-time Greeks and quotes.

# ── Tradier (FREE developer account) ──────────────────────────────────────────
# Sign up at: https://developer.tradier.com/
# After registration, copy your sandbox token here.
# For live data: fund a Tradier brokerage account and use your live token.

TRADIER_TOKEN=
TRADIER_SANDBOX=true

# ── Override risk-free rate if desired (default: 5.3%) ────────────────────────
# RISK_FREE_RATE=0.053
